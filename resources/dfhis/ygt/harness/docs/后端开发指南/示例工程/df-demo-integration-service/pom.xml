<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.df</groupId>
        <artifactId>df-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>df-demo-integration-service</artifactId>
    <name>df-demo-integration-service</name>
    <description>Integration example for redis lock and rabbitmq publish on df-java-base</description>

    <dependencies>
        <dependency>
            <groupId>com.df</groupId>
            <artifactId>df-core-starter</artifactId>
            <version>${df.version}</version>
        </dependency>
        <dependency>
            <groupId>com.df</groupId>
            <artifactId>df-tenant-starter</artifactId>
            <version>${df.version}</version>
        </dependency>
        <dependency>
            <groupId>com.df</groupId>
            <artifactId>df-redis-starter</artifactId>
            <version>${df.version}</version>
        </dependency>
        <dependency>
            <groupId>com.df</groupId>
            <artifactId>df-message-starter</artifactId>
            <version>${df.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>